#!/usr/bin/env python3
"""factory: the only writer of stage state.

Stages, transitions and the agent rule live in this file (STAGES, TRANSITIONS,
check_advance). Skills and hooks call this CLI; they never edit the board.
The stage of an issue is its Status on the GitHub Project of the foreman.

Rule: an agent move needs a human event after the last agent move.
Human events are directives (go, approve, verified, move, rework) and any stage
change that factory did not make (for example a card that the owner drags on the board).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tomllib
import urllib.parse
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

# --------------------------------------------------------------------------
# Domain: stages and transitions
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Stage:
    key: str
    status: str  # name of the Status option on the Project board
    color: str  # color of that option


STAGES = [
    Stage("backlog", "Backlog", "GRAY"),
    Stage("design", "In Design", "BLUE"),
    Stage("ready", "Ready for Dev", "PURPLE"),
    Stage("dev", "In Dev", "YELLOW"),
    Stage("verify", "Waiting for Verification", "ORANGE"),
    Stage("done", "Done", "GREEN"),
]
STAGE = {s.key: s for s in STAGES}
STATUS_STAGE = {s.status: s.key for s in STAGES}


@dataclass(frozen=True)
class Transition:
    frm: str
    to: str
    by: str  # "human" or "agent"
    directive: str | None = None  # human command that makes the move
    requires: str | None = None  # human directive needed before an agent move


TRANSITIONS = {
    "backlog": Transition("backlog", "design", "human", directive="go"),
    "design": Transition("design", "ready", "agent"),
    "ready": Transition("ready", "dev", "human", directive="approve"),
    "dev": Transition("dev", "verify", "agent"),
    "verify": Transition("verify", "done", "agent", requires="verified"),
}

FLAGS = {
    "claimed": "A session owns this issue.",
    "blocked": "The agent needs a human answer.",
    "rework": "The human gave feedback. The agent must revise.",
}
# Built-in Project workflows that move a card with no human and no `factory`. `factory setup` deletes them.
STATUS_WORKFLOWS = ("Item closed",)
FLAG_COLORS = {"claimed": "5319e7", "blocked": "b60205", "rework": "d93f0b"}

# Which WIP bucket an issue counts against, by stage.
WIP_BUCKET = {"design": "design", "ready": "design", "dev": "dev", "verify": "dev"}


# Commands that record a directive of the owner. `factory hook` stops them in work sessions.
HUMAN_COMMANDS = ("go", "approve", "verified", "move", "rework", "unblock")


def flag_label(flag: str) -> str:
    return f"factory:{flag}"


# --------------------------------------------------------------------------
# Domain: events (hidden marker comments on the issue)
# --------------------------------------------------------------------------

MARKER_RE = re.compile(r"<!--\s*factory:event\s+(\{.*?\})\s*-->", re.S)


@dataclass
class Event:
    actor: str  # "human" or "agent"
    kind: str  # advance | go | approve | verified | move | rework | claim | release | flag | unflag
    frm: str | None = None
    to: str | None = None
    session: str | None = None
    note: str | None = None
    at: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat(timespec="seconds"))

    def to_comment(self) -> str:
        data = {k: v for k, v in self.__dict__.items() if v is not None}
        return f"{self.summary()}\n\n<!-- factory:event {json.dumps(data, sort_keys=True)} -->"

    def summary(self) -> str:
        who = "🤖 agent" if self.actor == "agent" else "🧑 human"
        if self.frm and self.to:
            text = f"**{STAGE[self.frm].status} → {STAGE[self.to].status}** ({self.kind})"
        else:
            text = f"**{self.kind}**"
        if self.session:
            text += f" · session `{self.session}`"
        if self.note:
            text += f"\n\n{self.note}"
        return f"factory · {who}: {text}"


def parse_events(comments: list[str]) -> list[Event]:
    events = []
    for body in comments:
        for m in MARKER_RE.finditer(body or ""):
            try:
                data = json.loads(m.group(1))
                events.append(Event(**data))
            except (ValueError, TypeError):
                continue  # a malformed marker is not an event
    return events


# --------------------------------------------------------------------------
# Domain: pure rules
# --------------------------------------------------------------------------


class Refusal(Exception):
    """A rule says no. Exit code 1."""


class UsageError(Exception):
    """Bad input or config. Exit code 2."""


def check_advance(stage: str, events: list[Event]) -> Transition:
    """Return the transition an agent may make now, or raise Refusal."""
    t = TRANSITIONS.get(stage)
    if t is None:
        raise Refusal(f"{STAGE[stage].status} is the last stage")
    if t.by != "agent":
        raise Refusal(f"{STAGE[t.frm].status} → {STAGE[t.to].status} is a human move (`factory {t.directive}`)")

    agent_idx = [i for i, e in enumerate(events) if e.actor == "agent" and e.kind == "advance"]
    last = agent_idx[-1] if agent_idx else -1
    humans_after = [e for e in events[last + 1:] if e.actor == "human"]
    moved_outside_factory = last >= 0 and events[last].to != stage
    human_acted = last < 0 or bool(humans_after) or moved_outside_factory

    if not human_acted:
        raise Refusal("the last move was an agent move; a human event must come first")
    if t.requires and not any(e.kind == t.requires for e in humans_after):
        raise Refusal(f"{STAGE[t.frm].status} → {STAGE[t.to].status} needs the human directive `{t.requires}`")
    return t


def claim_owner(events: list[Event]) -> str | None:
    owner = None
    for e in events:
        if e.kind == "claim":
            owner = e.session
        elif e.kind == "release":
            owner = None
    return owner


def next_action(stage: str, flags: list[str], events: list[Event]) -> str | None:
    """The skill the tick must start for this issue, or None."""
    if "claimed" in flags or "blocked" in flags:
        return None
    if "rework" in flags:
        return "rework"
    if stage == "design":
        return "design"
    if stage == "dev":
        return "develop"
    if stage == "verify":
        try:
            check_advance(stage, events)
            return "ship"
        except Refusal:
            return None
    return None


def plan_starts(issues: list[dict], wip: dict[str, int]) -> list[str]:
    """IDs to start now, oldest issue first, inside the WIP limits."""
    active = {b: 0 for b in wip}
    for i in issues:
        bucket = WIP_BUCKET.get(i["stage"])
        if bucket and "claimed" in i["flags"]:
            active[bucket] = active.get(bucket, 0) + 1
    starts = []
    for i in sorted(issues, key=lambda i: i["number"]):
        bucket = WIP_BUCKET.get(i["stage"])
        if i["next_action"] and bucket and active.get(bucket, 0) < wip.get(bucket, 0):
            active[bucket] += 1
            starts.append(i["id"])
    return starts


# --------------------------------------------------------------------------
# Foremen and issue references
# --------------------------------------------------------------------------

NAME_RE = re.compile(r"^[a-z][a-z0-9]{1,7}$")
REF_RE = re.compile(r"^\s*(?:([a-z][a-z0-9]{1,7})\s*[\s#-]\s*)?(\d+)\s*$", re.I)


@dataclass
class Foreman:
    name: str  # what the owner calls the foreman: `fred go 6`
    prefix: str  # what the issue IDs start with: FACTORY-6. Default: the name.
    title: str
    github: str  # owner/repo of the issue tracker (the home repo)
    project: int | None  # number of the GitHub Project (the board) of the same owner
    root: Path  # folder that holds foreman.toml (the registry folder)
    home: Path  # project home: designs, mockups and delivery docs. Default: root.
    repos: list[dict]
    wip: dict[str, int]

    def ref(self, number: int) -> str:
        return f"{self.prefix.upper()}-{number}"


def load_foreman(path: Path) -> Foreman:
    try:
        data = tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise UsageError(f"{path}: {e}") from e
    name = data.get("name", "")
    if not NAME_RE.match(name):
        raise UsageError(f"{path}: name {name!r} must be 2-8 lowercase letters or digits, first a letter")
    prefix = data.get("prefix", name)
    if not isinstance(prefix, str) or not NAME_RE.match(prefix):
        raise UsageError(f"{path}: prefix {prefix!r} must be 2-8 lowercase letters or digits, first a letter")
    github = data.get("github", "")
    if not re.match(r"^[\w.-]+/[\w.-]+$", github):
        raise UsageError(f"{path}: github must be owner/repo, got {github!r}")
    project = data.get("project")
    if project is not None and (not isinstance(project, int) or isinstance(project, bool) or project < 1):
        raise UsageError(f"{path}: project must be the number of a GitHub Project, got {project!r}")
    root = path.parent.resolve()
    home = data.get("home", ".")
    if not isinstance(home, str) or not home:
        raise UsageError(f"{path}: home must be the path of the project home folder, got {home!r}")
    home = (root / Path(home).expanduser()).resolve()
    if not home.is_dir():
        raise UsageError(f"{path}: home {str(home)!r} is not a folder")
    repos = []
    for r in data.get("repos", []):
        repos.append({**r, "path": str((root / r.get("path", ".")).resolve())})
    wip = {"design": 2, "dev": 3, **data.get("wip", {})}
    return Foreman(name, prefix, data.get("title", name), github, project, root, home, repos, wip)


def registry_path() -> Path:
    env = os.environ.get("FACTORY_REGISTRY")
    return Path(env).expanduser() if env else Path.home() / ".config" / "factory" / "foremen.toml"


def read_registry() -> dict[str, Path]:
    """foremen.toml: one line per foreman, `name = "path to home repo"`."""
    path = registry_path()
    if not path.exists():
        return {}
    try:
        data = tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as e:
        raise UsageError(f"{path}: {e}") from e
    return {name: Path(home).expanduser() for name, home in data.items()}


def write_registry(entries: dict[str, Path]) -> None:
    home = str(Path.home())
    lines = ["# Foreman registry: name = home repo folder. Edit with `factory register`.\n"]
    for name in sorted(entries):
        p = str(entries[name])
        p = "~" + p[len(home):] if p.startswith(home + os.sep) else p
        lines.append(f'{name} = "{p}"\n')
    registry_path().parent.mkdir(parents=True, exist_ok=True)
    registry_path().write_text("".join(lines))


def load_registered(name: str, home: Path) -> Foreman:
    path = home / "foreman.toml"
    if not path.is_file():
        raise UsageError(f"foreman {name!r}: {path} does not exist; fix {registry_path()}")
    f = load_foreman(path)
    if f.name != name:
        raise UsageError(f"{registry_path()} says {name!r} but {path} says {f.name!r}")
    return f


def all_foremen() -> dict[str, Foreman]:
    return {n: load_registered(n, h) for n, h in read_registry().items()}


def get_foreman(name: str | None) -> Foreman:
    reg = read_registry()
    if name:
        name = name.lower()
        found = [f for f in all_foremen().values() if name in (f.name, f.prefix)]
        if not found:
            raise UsageError(f"no foreman named {name!r}; known: {', '.join(sorted(reg)) or 'none'}")
        if len(found) > 1:
            raise UsageError(f"{name!r} is the name or prefix of more than one foreman: "
                             f"{', '.join(sorted(f.name for f in found))}; change a prefix in foreman.toml")
        return found[0]
    here = Path.cwd().resolve()
    for d in [here, *here.parents]:
        if (d / "foreman.toml").is_file():
            f = load_foreman(d / "foreman.toml")
            if f.name not in reg:
                raise UsageError(f"foreman {f.name!r} is not registered; run `factory register {d}`")
            return load_registered(f.name, reg[f.name])
    if len(reg) == 1:
        (n, h), = reg.items()
        return load_registered(n, h)
    raise UsageError("no foreman here; give a name, for example `cc`")


def op_register(folder: str) -> str:
    home = Path(folder).expanduser().resolve()
    f = load_foreman(home / "foreman.toml")
    reg = read_registry()
    old = reg.get(f.name)
    if old is not None and old.resolve() == home:
        return f"{f.name}: already registered at {home}"
    if old is not None:
        raise Refusal(f"{f.name!r} is already registered at {old}; use another name or edit {registry_path()}")
    for n, h in reg.items():
        if h.resolve() == home:
            raise Refusal(f"{home} is already registered as {n!r}")
    reg[f.name] = home
    write_registry(reg)
    return f"{f.name}: registered at {home}"


def resolve(text: str) -> tuple[Foreman, int]:
    m = REF_RE.match(text)
    if not m:
        raise UsageError(f"{text!r} is not an issue reference; use CC-42, cc#42, cc 42 or 42")
    return get_foreman(m.group(1)), int(m.group(2))


# --------------------------------------------------------------------------
# Backends (the only code that touches storage)
# --------------------------------------------------------------------------


class GhBackend:
    """GitHub through the `gh` CLI. The Status field of the Project holds the stage; labels hold the flags."""

    def __init__(self, repo: str, project: int | None):
        self.repo, self.number = repo, project
        self.owner, self.name = repo.split("/")
        self._board: dict | None = None
        self._node: dict[int, str] = {}

    def _run(self, cmd: list[str]) -> str:
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode != 0:
            raise UsageError(f"gh failed: {' '.join(cmd)}\n{(r.stderr or r.stdout).strip()}")
        return r.stdout

    def _api(self, path: str, *args: str, paginate: bool = False):
        cmd = ["gh", "api", f"repos/{self.repo}/{path}", *args]
        if paginate:
            cmd.insert(2, "--paginate")
        return _parse_json_stream(self._run(cmd))

    def _gql(self, query: str, **variables) -> dict:
        cmd = ["gh", "api", "graphql", "-f", f"query={query}"]
        for k, v in variables.items():
            cmd += ["-F" if isinstance(v, int) else "-f", f"{k}={v}"]
        return json.loads(self._run(cmd))["data"]

    def board(self) -> dict:
        """The Project: its ID, the Status field, the options by name, the views, the linked repos."""
        if self._board is None:
            data = self._gql("""query($owner:String!,$number:Int!){ repositoryOwner(login:$owner){ ... on ProjectV2Owner {
                projectV2(number:$number){ id url
                  field(name:"Status"){ ... on ProjectV2SingleSelectField { id options { id name } } }
                  views(first:20){ nodes { id name layout } }
                  workflows(first:20){ nodes { id name } }
                  repositories(first:50){ nodes { nameWithOwner } } } } } }""", owner=self.owner, number=self.number)
            pr = (data.get("repositoryOwner") or {}).get("projectV2")
            if not pr or not pr.get("field"):
                raise UsageError(f"{self.owner} has no Project {self.number} with a Status field")
            self._board = {"id": pr["id"], "url": pr["url"], "field": pr["field"]["id"],
                           "options": {o["name"]: o["id"] for o in pr["field"]["options"]},
                           "views": pr["views"]["nodes"], "workflows": pr["workflows"]["nodes"],
                           "repos": [r["nameWithOwner"] for r in pr["repositories"]["nodes"]]}
        return self._board

    def make_project(self, title: str) -> tuple[int, bool]:
        """The open Project of the owner with this title, or a new one. Returns (number, made)."""
        data = self._gql("""query($owner:String!){ repositoryOwner(login:$owner){ id ... on ProjectV2Owner {
            projectsV2(first:100){ nodes { number title closed } } } } }""", owner=self.owner)["repositoryOwner"]
        found = [p["number"] for p in data["projectsV2"]["nodes"] if p["title"] == title and not p["closed"]]
        if found:
            return min(found), False
        return self._gql("""mutation($owner:ID!,$title:String!){ createProjectV2(input:{ownerId:$owner,title:$title}){
            projectV2 { number } } }""", owner=data["id"], title=title)["createProjectV2"]["projectV2"]["number"], True

    def issue(self, n: int) -> dict:
        data = self._gql("""query($owner:String!,$name:String!,$n:Int!){ repository(owner:$owner,name:$name){
            issue(number:$n){ id title state labels(first:50){ nodes { name } }
              projectItems(first:20){ nodes { project { id }
                fieldValueByName(name:"Status"){ ... on ProjectV2ItemFieldSingleSelectValue { name } } } } } } }""",
                         owner=self.owner, name=self.name, n=n)
        i = data["repository"]["issue"]
        self._node[n] = i["id"]
        board = self.board()["id"]
        status = next(((item["fieldValueByName"] or {}).get("name") for item in i["projectItems"]["nodes"]
                       if item["project"]["id"] == board), None)
        labels = [l["name"] for l in i["labels"]["nodes"]]
        return {"title": i["title"], "state": i["state"].lower(), "stage": STATUS_STAGE.get(status),
                "flags": [f for f in FLAGS if flag_label(f) in labels]}

    def comments(self, n: int) -> list[str]:
        pages = self._api(f"issues/{n}/comments?per_page=100", paginate=True)
        return [c["body"] for page in pages for c in page]

    def open_issues(self) -> list[int]:
        """GraphQL, not the REST list: the REST list can lag behind a close or a reopen for some seconds."""
        numbers, cursor = [], {}
        while True:
            page = self._gql("""query($owner:String!,$name:String!,$after:String){ repository(owner:$owner,name:$name){
                issues(states:OPEN,first:100,after:$after){ pageInfo { hasNextPage endCursor } nodes { number } } } }""",
                             owner=self.owner, name=self.name, **cursor)["repository"]["issues"]
            numbers += [i["number"] for i in page["nodes"]]
            if not page["pageInfo"]["hasNextPage"]:
                return sorted(numbers)
            cursor = {"after": page["pageInfo"]["endCursor"]}

    def set_stage(self, n: int, stage: str) -> None:
        """Put the issue on the board (no change if it is there) and set its Status."""
        b = self.board()
        option = b["options"].get(STAGE[stage].status)
        if option is None:
            raise UsageError(f"{b['url']} has no Status option {STAGE[stage].status!r}; run `factory setup`")
        if n not in self._node:
            self.issue(n)
        item = self._gql("""mutation($project:ID!,$content:ID!){
            addProjectV2ItemById(input:{projectId:$project,contentId:$content}){ item { id } } }""",
                         project=b["id"], content=self._node[n])["addProjectV2ItemById"]["item"]["id"]
        self._gql("""mutation($project:ID!,$item:ID!,$field:ID!,$option:String!){
            updateProjectV2ItemFieldValue(input:{projectId:$project,itemId:$item,fieldId:$field,
              value:{singleSelectOptionId:$option}}){ projectV2Item { id } } }""",
                  project=b["id"], item=item, field=b["field"], option=option)

    def set_flag(self, n: int, flag: str, on: bool) -> None:
        if on:
            self._api(f"issues/{n}/labels", "-X", "POST", "-f", f"labels[]={flag_label(flag)}")
        else:
            self._api(f"issues/{n}/labels/{urllib.parse.quote(flag_label(flag), safe='')}", "-X", "DELETE")

    def comment(self, n: int, body: str) -> None:
        self._api(f"issues/{n}/comments", "-X", "POST", "-f", f"body={body}")

    def set_state(self, n: int, state: str) -> None:
        self._api(f"issues/{n}", "-X", "PATCH", "-f", f"state={state}")

    def create_issue(self, title: str, body: str) -> int:
        return self._api("issues", "-X", "POST", "-f", f"title={title}", "-f", f"body={body}")[0]["number"]

    def setup(self) -> list[str]:
        """Make the board ready: Status options, a Board view, the repo link, no workflow that moves a
        card, the flag labels. Idempotent."""
        b, done = self.board(), []
        if list(b["options"]) != [s.status for s in STAGES]:
            options = ",".join(
                "{" + (f"id:{json.dumps(b['options'][s.status])}," if s.status in b["options"] else "")
                + f'name:{json.dumps(s.status)},color:{s.color},description:""' + "}" for s in STAGES)
            self._gql("mutation($field:ID!){ updateProjectV2Field(input:{fieldId:$field,singleSelectOptions:[%s]}){"
                      " projectV2Field { ... on ProjectV2SingleSelectField { id } } } }" % options, field=b["field"])
            done.append("Status options set")
        if not any(v["layout"] == "BOARD_LAYOUT" for v in b["views"]):
            self._gql("""mutation($view:ID!){ updateProjectV2View(input:{viewId:$view,name:"Board",layout:BOARD_LAYOUT}){
                projectV2View { id } } }""", view=b["views"][0]["id"])
            done.append("Board view made")
        if self.repo not in b["repos"]:
            repo = self._gql("query($owner:String!,$name:String!){ repository(owner:$owner,name:$name){ id } }",
                             owner=self.owner, name=self.name)["repository"]["id"]
            self._gql("""mutation($project:ID!,$repo:ID!){ linkProjectV2ToRepository(input:{projectId:$project,
                repositoryId:$repo}){ repository { id } } }""", project=b["id"], repo=repo)
            done.append("repo linked")
        for w in b["workflows"]:
            if w["name"] in STATUS_WORKFLOWS:  # a second writer of the Status; only factory and the owner write it
                self._gql("mutation($w:ID!){ deleteProjectV2Workflow(input:{workflowId:$w}){ deletedWorkflowId } }",
                          w=w["id"])
                done.append(f"workflow {w['name']!r} deleted")
        for flag, desc in FLAGS.items():
            self._run(["gh", "label", "create", flag_label(flag), "--repo", self.repo, "--color", FLAG_COLORS[flag],
                       "--description", desc, "--force"])
        self._board = None
        return done


def _parse_json_stream(text: str) -> list:
    """`gh api --paginate` prints one JSON value per page."""
    dec, out, i = json.JSONDecoder(), [], 0
    while i < len(text):
        if text[i].isspace():
            i += 1
            continue
        value, i = dec.raw_decode(text, i)
        out.append(value)
    return out


class FakeBackend:
    """A JSON file that acts as GitHub, for tests and dry runs (FACTORY_FAKE=path)."""

    def __init__(self, repo: str, path: Path):
        self.repo, self.path = repo, path

    def _load(self) -> dict:
        db = json.loads(self.path.read_text()) if self.path.exists() else {}
        return db

    def _issues(self, db: dict) -> dict:
        return db.setdefault(self.repo, {}).setdefault("issues", {})

    def _edit(self, fn):
        db = self._load()
        result = fn(self._issues(db))
        self.path.write_text(json.dumps(db, indent=2))
        return result

    def _get(self, n: int) -> dict:
        issue = self._issues(self._load()).get(str(n))
        if issue is None:
            raise UsageError(f"{self.repo}#{n} does not exist")
        return issue

    def issue(self, n: int) -> dict:
        i = self._get(n)
        return {"title": i["title"], "state": i["state"], "stage": i["stage"], "flags": list(i["flags"])}

    def comments(self, n: int) -> list[str]:
        return list(self._get(n)["comments"])

    def open_issues(self) -> list[int]:
        return sorted(int(k) for k, v in self._issues(self._load()).items() if v["state"] == "open")

    def set_stage(self, n: int, stage: str) -> None:
        self._get(n)
        self._edit(lambda iss: iss[str(n)].__setitem__("stage", stage))

    def set_flag(self, n: int, flag: str, on: bool) -> None:
        self._get(n)
        self._edit(lambda iss: iss[str(n)].__setitem__(
            "flags", [f for f in FLAGS if (f in iss[str(n)]["flags"] and f != flag) or (f == flag and on)]))

    def comment(self, n: int, body: str) -> None:
        self._edit(lambda iss: iss[str(n)]["comments"].append(body))

    def set_state(self, n: int, state: str) -> None:
        self._edit(lambda iss: iss[str(n)].__setitem__("state", state))

    def create_issue(self, title: str, body: str) -> int:
        def add(iss):
            n = max((int(k) for k in iss), default=0) + 1
            iss[str(n)] = {"title": title, "body": body, "state": "open", "stage": None, "flags": [], "comments": []}
            return n
        return self._edit(add)

    def setup(self) -> list[str]:
        return []

    def make_project(self, title: str) -> tuple[int, bool]:
        def find_or_add(db):
            projects = db.setdefault(self.repo.split("/")[0], {}).setdefault("projects", [])
            if title in projects:
                return projects.index(title) + 1, False
            projects.append(title)
            return len(projects), True
        db = self._load()
        result = find_or_add(db)
        self.path.write_text(json.dumps(db, indent=2))
        return result


def backend_for(f: Foreman, board: bool = True):
    """board=False: the Project may not exist yet (only `factory setup` makes it)."""
    fake = os.environ.get("FACTORY_FAKE")
    if fake:
        return FakeBackend(f.github, Path(fake))
    if f.github.startswith("OWNER/"):
        raise UsageError(f"{f.root / 'foreman.toml'}: set github to the real owner/repo")
    if f.project is None and board:
        raise UsageError(f"{f.root / 'foreman.toml'}: set project to the number of the GitHub Project (the board), "
                         "or run `factory setup` to make the board")
    return GhBackend(f.github, f.project)


# --------------------------------------------------------------------------
# Operations (read state, apply a pure rule, write)
# --------------------------------------------------------------------------


@dataclass
class IssueState:
    foreman: Foreman
    number: int
    title: str
    state: str
    stage_key: str | None  # None: the issue is not on the board
    flags: list[str]
    events: list[Event]

    @property
    def id(self) -> str:
        return self.foreman.ref(self.number)

    @property
    def stage(self) -> str:
        if self.stage_key is None:
            raise Refusal(f"{self.id} has no stage: it is not on the board; a human must run "
                          f"`factory move {self.id} backlog`")
        return self.stage_key


def read(f: Foreman, n: int, be=None) -> IssueState:
    be = be or backend_for(f)
    i = be.issue(n)
    return IssueState(f, n, i["title"], i["state"], i["stage"], i["flags"], parse_events(be.comments(n)))


def write_stage(be, s: IssueState, to: str, event: Event) -> None:
    be.set_stage(s.number, to)
    be.comment(s.number, event.to_comment())
    if to == "done" and s.state != "closed":
        be.set_state(s.number, "closed")
    elif to != "done" and s.state == "closed":
        be.set_state(s.number, "open")


def op_advance(ref: str, session: str | None) -> str:
    f, n = resolve(ref)
    be = backend_for(f)
    s = read(f, n, be)
    t = check_advance(s.stage, s.events)
    write_stage(be, s, t.to, Event("agent", "advance", t.frm, t.to, session=session))
    return f"{s.id}: {STAGE[t.frm].status} → {STAGE[t.to].status}"


def op_directive(ref: str, directive: str, note: str | None) -> str:
    f, n = resolve(ref)
    be = backend_for(f)
    s = read(f, n, be)
    stage = s.stage
    if directive == "verified":
        if stage != "verify":
            raise Refusal(f"{s.id} is in {STAGE[stage].status}; `verified` needs {STAGE['verify'].status}")
        be.comment(n, Event("human", "verified", note=note).to_comment())
        return f"{s.id}: verified; the agent can now merge, test and close"
    t = next((t for t in TRANSITIONS.values() if t.directive == directive), None)
    if t is None:
        raise UsageError(f"unknown directive {directive!r}")
    if stage != t.frm:
        raise Refusal(f"{s.id} is in {STAGE[stage].status}; `{directive}` needs {STAGE[t.frm].status}")
    write_stage(be, s, t.to, Event("human", directive, t.frm, t.to, note=note))
    return f"{s.id}: {STAGE[t.frm].status} → {STAGE[t.to].status}"


def op_move(ref: str, to: str, note: str | None) -> str:
    if to not in STAGE:
        raise UsageError(f"unknown stage {to!r}; use one of {', '.join(STAGE)}")
    f, n = resolve(ref)
    be = backend_for(f)
    s = read(f, n, be)
    frm = s.stage_key
    if frm == to:
        return f"{s.id}: already in {STAGE[to].status}"
    write_stage(be, s, to, Event("human", "move", frm, to, note=note))
    return f"{s.id}: {STAGE[frm].status if frm else 'not on the board'} → {STAGE[to].status}"


def op_flag(ref: str, flag: str, on: bool, actor: str, note: str | None) -> str:
    if flag not in FLAGS or flag == "claimed":
        raise UsageError(f"unknown flag {flag!r}; use blocked or rework (claims use `factory claim`)")
    f, n = resolve(ref)
    be = backend_for(f)
    s = read(f, n, be)
    if on == (flag in s.flags):
        return f"{s.id}: {flag} already {'set' if on else 'clear'}"
    be.set_flag(n, flag, on)
    kind = flag if (on and flag == "rework") else ("flag" if on else "unflag")
    be.comment(n, Event(actor, kind, note=note or f"{flag} {'set' if on else 'cleared'}").to_comment())
    return f"{s.id}: {flag} {'set' if on else 'cleared'}"


def op_claim(ref: str, session: str) -> str:
    f, n = resolve(ref)
    be = backend_for(f)
    s = read(f, n, be)
    owner = claim_owner(s.events)
    if "claimed" in s.flags:
        if owner == session:
            return f"{s.id}: already claimed by {session}"
        raise Refusal(f"{s.id} is claimed by {owner or 'an unknown session'}")
    be.set_flag(n, "claimed", True)
    be.comment(n, Event("agent", "claim", session=session).to_comment())
    return f"{s.id}: claimed by {session}"


def op_release(ref: str) -> str:
    f, n = resolve(ref)
    be = backend_for(f)
    s = read(f, n, be)
    if "claimed" not in s.flags:
        return f"{s.id}: not claimed"
    be.set_flag(n, "claimed", False)
    be.comment(n, Event("agent", "release", session=claim_owner(s.events)).to_comment())
    return f"{s.id}: released"


def op_new(foreman: str | None, title: str, body: str) -> str:
    f = get_foreman(foreman)
    be = backend_for(f)
    n = be.create_issue(title, body)
    be.set_stage(n, "backlog")
    return f"{f.ref(n)}: created in {STAGE['backlog'].status}"


def issue_summary(s: IssueState) -> dict:
    try:
        stage = s.stage
    except Refusal as e:
        return {"id": s.id, "number": s.number, "title": s.title, "stage": None, "flags": s.flags,
                "next_action": None, "error": str(e)}
    return {"id": s.id, "number": s.number, "title": s.title, "stage": stage, "flags": s.flags,
            "next_action": next_action(stage, s.flags, s.events), "claimed_by": claim_owner(s.events)}


def op_status(foreman: str | None) -> dict:
    f = get_foreman(foreman)
    be = backend_for(f)
    issues = [issue_summary(read(f, n, be)) for n in be.open_issues()]
    return {"foreman": f.name, "github": f.github, "root": str(f.root), "home": str(f.home),
            "designs": str(f.home / "docs" / "designs"), "mockups": str(f.home / "mockups"),
            "repos": f.repos, "wip": f.wip,
            "issues": issues, "start": plan_starts(issues, f.wip)}


def op_audit(foreman: str | None) -> list[str]:
    f = get_foreman(foreman)
    be = backend_for(f)
    problems = []
    for n in be.open_issues():
        s = read(f, n, be)
        try:
            s.stage
        except Refusal as e:
            problems.append(str(e))
            continue
        if "claimed" in s.flags and not claim_owner(s.events):
            problems.append(f"{s.id}: claimed label with no claim event")
        if s.stage_key == "done" and s.state == "open":  # the list of open issues can be stale
            problems.append(f"{s.id}: in Done but the issue is open; a human must close it or move it")
    return problems


def write_project_number(path: Path, number: int) -> None:
    """Add `project = N` to foreman.toml, above the first table, so that it is a top-level key."""
    lines = path.read_text().splitlines(keepends=True)
    at = next((i for i, line in enumerate(lines) if line.lstrip().startswith("[")), len(lines))
    if at and not lines[at - 1].endswith("\n"):
        lines[at - 1] += "\n"
    lines.insert(at, f"project = {number}   # the board; `factory setup` wrote this\n")
    path.write_text("".join(lines))


def op_setup(foreman: str | None) -> str:
    f = get_foreman(foreman)
    done = []
    if f.project is None:
        number, made = backend_for(f, board=False).make_project(f.title)
        write_project_number(f.root / "foreman.toml", number)
        done.append(f"Project {number} {'made' if made else 'found'}, foreman.toml updated")
        f = load_foreman(f.root / "foreman.toml")
    done += backend_for(f).setup()
    return f"{f.name}: the board and the flag labels are ready" + (f" ({', '.join(done)})" if done else "")


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------


def format_status(st: dict) -> str:
    lines = [f"{st['foreman']} ({st['github']})"]
    if st["home"] != st["root"]:
        lines.append(f"project home: {st['home']}")
    by_stage: dict[str | None, list[dict]] = {}
    for i in st["issues"]:
        by_stage.setdefault(i["stage"], []).append(i)
    for s in [*STAGES, None]:
        key = s.key if s else None
        items = by_stage.get(key, [])
        if not items:
            continue
        lines.append(f"\n{s.status if s else 'Problems'}")
        for i in items:
            extra = " ".join(f"[{f}]" for f in i["flags"])
            action = f" → {i['next_action']}" if i["next_action"] else ""
            err = f"  ! {i['error']}" if i.get("error") else ""
            lines.append(f"  {i['id']:<10} {i['title']} {extra}{action}{err}".rstrip())
    lines.append(f"\nstart now: {', '.join(st['start']) or 'nothing'}")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# Hook: the Claude Code PreToolUse guard (hooks/hooks.json)
# --------------------------------------------------------------------------

PROTECTED_RE = re.compile(r"\bfactory:[a-z]")  # the flag labels and the factory:event marker
BOARD_WRITE_RE = re.compile(  # the board holds the stages: every Project write goes through factory
    r"\bgh\s+project\s+(?!list\b|view\b|item-list\b|field-list\b)[a-z]"
    r"|\bgh\s+api\s+graphql\b(?=.*\bmutation\b)(?=.*ProjectV2)", re.S | re.I)
GH_WRITE_RE = re.compile(
    r"\bgh\s+(?:issue|pr)\s+(?:edit|create|comment)\b"
    r"|\bgh\s+label\s+(?:create|edit|delete|clone)\b"
    r"|\bgh\s+api\b(?=.*\s(?:-X|--method|-f|-F|--field|--raw-field|--input)\b)"
    r"|\bcurl\b", re.S)
HUMAN_CALL_RE = re.compile(r"(?:^|[\s;&|()/'\"`])factory\s+(%s)\b" % "|".join(HUMAN_COMMANDS))


def is_linked_worktree(folder: Path) -> bool:
    """Work sessions run in linked git worktrees; the foreman runs in the main checkout."""
    for d in [folder, *folder.parents]:
        git = d / ".git"
        if git.is_file():
            return "/worktrees/" in git.read_text(errors="replace")
        if git.is_dir():
            return False
    return False


def check_hook(data: dict, project_dir: str | None) -> None:
    """Raise Refusal if the tool call goes around the factory rules."""
    if data.get("tool_name") != "Bash":
        return
    command = (data.get("tool_input") or {}).get("command") or ""
    if PROTECTED_RE.search(command) and GH_WRITE_RE.search(command):
        raise Refusal("only the `factory` CLI writes `factory:*` labels and `factory:event` markers; "
                      "run `factory --help`")
    if BOARD_WRITE_RE.search(command):
        raise Refusal("only the `factory` CLI writes the Project board, which holds the stages; "
                      "run `factory --help`")
    m = HUMAN_CALL_RE.search(command)
    if m and data.get("agent_id"):
        raise Refusal(f"`factory {m[1]}` is a human command; a subagent cannot run it")
    if m and is_linked_worktree(Path(project_dir or data.get("cwd") or ".")):
        raise Refusal(f"`factory {m[1]}` is a human command; a work session cannot run it. "
                      "Stop and report to the owner.")


def run_hook(raw: str) -> int:
    """Exit code 0 permits the tool call. Exit code 2 stops it; Claude gets stderr."""
    try:
        data = json.loads(raw)
        if not isinstance(data, dict):
            raise ValueError
        check_hook(data, os.environ.get("CLAUDE_PROJECT_DIR"))
    except ValueError:
        print("factory hook: cannot read the hook input", file=sys.stderr)
        return 2
    except Refusal as e:
        print(f"factory hook: {e}", file=sys.stderr)
        return 2
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="factory", description="Factory stage state. The only writer of the Project board.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("stages", help="print stages and transitions")
    sub.add_parser("foremen", help="list registered foremen (foremen.toml)")
    rg = sub.add_parser("register", help="add a home repo folder to foremen.toml")
    rg.add_argument("folder")
    r = sub.add_parser("resolve", help="turn CC-42, cc#42, 'cc 42' or 42 into a canonical ID")
    r.add_argument("ref")
    s = sub.add_parser("status", help="issues by stage, and what the tick must start")
    s.add_argument("foreman", nargs="?")
    s.add_argument("--json", action="store_true")
    sh = sub.add_parser("show", help="one issue with its events")
    sh.add_argument("ref")

    a = sub.add_parser("advance", help="AGENT: move one stage forward if the rule permits")
    a.add_argument("ref")
    a.add_argument("--session")
    c = sub.add_parser("claim", help="AGENT: mark that a session owns the issue")
    c.add_argument("ref")
    c.add_argument("session")
    rl = sub.add_parser("release", help="AGENT: remove the claim")
    rl.add_argument("ref")
    b = sub.add_parser("block", help="AGENT: set blocked, with the question")
    b.add_argument("ref")
    b.add_argument("note")
    rd = sub.add_parser("reworked", help="AGENT: clear rework after the revision")
    rd.add_argument("ref")

    for d, h in [("go", "Backlog → In Design"), ("approve", "Ready for Dev → In Dev"),
                 ("verified", "permit the agent to merge, test and close")]:
        x = sub.add_parser(d, help=f"HUMAN: {h}")
        x.add_argument("ref")
        x.add_argument("--note")
    m = sub.add_parser("move", help="HUMAN: move to any stage")
    m.add_argument("ref")
    m.add_argument("stage")
    m.add_argument("--note")
    rw = sub.add_parser("rework", help="HUMAN: ask for a revision")
    rw.add_argument("ref")
    rw.add_argument("note")
    ub = sub.add_parser("unblock", help="HUMAN: clear blocked after you answer")
    ub.add_argument("ref")
    ub.add_argument("--note")

    n = sub.add_parser("new", help="create an issue in Backlog")
    n.add_argument("title")
    n.add_argument("--foreman")
    n.add_argument("--body", default="")
    au = sub.add_parser("audit", help="find illegal states")
    au.add_argument("foreman", nargs="?")
    lb = sub.add_parser("setup", help="make the Project board and the flag labels ready (idempotent)")
    lb.add_argument("foreman", nargs="?")
    sub.add_parser("hook", help="Claude Code PreToolUse guard: hook JSON on stdin, exit code 2 stops the call")

    args = p.parse_args(argv)
    if args.cmd == "hook":
        return run_hook(sys.stdin.read())
    try:
        out = dispatch(args)
    except Refusal as e:
        print(f"refused: {e}", file=sys.stderr)
        return 1
    except UsageError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if out is not None:
        print(out)
    return 0


def dispatch(a) -> str | None:
    match a.cmd:
        case "stages":
            rows = []
            for st in STAGES:
                t = TRANSITIONS.get(st.key)
                if t:
                    how = f"human `factory {t.directive}`" if t.by == "human" else "agent `factory advance`"
                    if t.requires:
                        how += f" after human `factory {t.requires}`"
                    rows.append(f"{st.status:<26} → {STAGE[t.to].status:<26} {how}")
            return "\n".join(rows)
        case "foremen":
            fs = all_foremen()
            return "\n".join(f"{f.name:<8} {f.github:<30} {f.root}" for f in fs.values()) or "no foremen"
        case "register":
            return op_register(a.folder)
        case "resolve":
            f, num = resolve(a.ref)
            return json.dumps({"id": f.ref(num), "foreman": f.name, "github": f.github, "number": num})
        case "status":
            st = op_status(a.foreman)
            return json.dumps(st, indent=2) if a.json else format_status(st)
        case "show":
            f, num = resolve(a.ref)
            s = read(f, num)
            return json.dumps({**issue_summary(s), "events": [e.__dict__ for e in s.events]}, indent=2)
        case "advance":
            return op_advance(a.ref, a.session)
        case "claim":
            return op_claim(a.ref, a.session)
        case "release":
            return op_release(a.ref)
        case "block":
            return op_flag(a.ref, "blocked", True, "agent", a.note)
        case "reworked":
            return op_flag(a.ref, "rework", False, "agent", None)
        case "go" | "approve" | "verified":
            return op_directive(a.ref, a.cmd, a.note)
        case "move":
            return op_move(a.ref, a.stage, a.note)
        case "rework":
            return op_flag(a.ref, "rework", True, "human", a.note)
        case "unblock":
            return op_flag(a.ref, "blocked", False, "human", a.note)
        case "new":
            return op_new(a.foreman, a.title, a.body)
        case "audit":
            problems = op_audit(a.foreman)
            if problems:
                raise Refusal("\n" + "\n".join(problems))
            return "no problems"
        case "setup":
            return op_setup(a.foreman)


if __name__ == "__main__":
    sys.exit(main())
